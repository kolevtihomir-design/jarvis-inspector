# ── Jarvis Inspector — API Keys ──────────────────────────────────────────
# Копирай този файл като .env и попълни ключовете

# Groq (безплатно — https://console.groq.com)
GROQ_API_KEY=

# OpenRouter (безплатно — https://openrouter.ai)
OPENROUTER_API_KEY=

# Google Gemini (безплатно — https://aistudio.google.com)
GOOGLE_API_KEY=

# Lemon Squeezy (за PRO лицензи — https://lemonsqueezy.com)
LEMON_SQUEEZY_API_KEY=

# Порт (по подразбиране 3002)
INSPECTOR_PORT=3002
