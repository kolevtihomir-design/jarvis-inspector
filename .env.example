# ══════════════════════════════════════════════════════════════
#  Jarvis Inspector — .env  (копирай като .env и попълни)
# ══════════════════════════════════════════════════════════════

# ── AI API Keys (поне един е задължителен) ──────────────────
# Groq — безплатно, бързо: https://console.groq.com
# Може и pool от ключове (comma-separated): GROQ_API_KEYS=key1,key2,key3
GROQ_API_KEY=

# OpenRouter — безплатни модели: https://openrouter.ai
# Може и pool: OPENROUTER_API_KEYS=key1,key2
OPENROUTER_API_KEY=

# Google Gemini — безплатна квота: https://aistudio.google.com
# Ключът ТРЯБВА да започва с "AIzaSy..." (от aistudio.google.com)
GEMINI_API_KEY=
# GOOGLE_API_KEY= е legacy алтернатива — сървърът чете и двете

# ── Lemon Squeezy (плащания) ─────────────────────────────────
# API Key: https://app.lemonsqueezy.com/settings/api
LEMON_SQUEEZY_API_KEY=

# Webhook Secret: LS Dashboard → Settings → Webhooks → Add Webhook
# URL: http://YOUR_IP:3002/api/webhooks/lemon-squeezy
# Events: subscription_created, subscription_activated,
#         subscription_cancelled, subscription_expired, order_created
LEMON_SQUEEZY_WEBHOOK_SECRET=

# URL на твоя магазин (без trailing slash)
LEMON_SQUEEZY_STORE_URL=https://YOUR-STORE.lemonsqueezy.com

# Variant ID за всеки план (LS Dashboard → Products → твоя продукт → Variants)
LS_VARIANT_PRO=
LS_VARIANT_CREATOR=
LS_VARIANT_BUSINESS=

# ── Сървър ───────────────────────────────────────────────────
INSPECTOR_PORT=3002
