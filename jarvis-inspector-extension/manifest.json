{
  "manifest_version": 3,
  "name": "JARVIS Inspector",
  "version": "2.0.0",
  "description": "Един бутон. Истината за секунди. Натисни и виж дали е фалшиво или истинско.",
  "permissions": ["tabs", "activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>", "https://*.vercel.app/*"],
  "action": {
    "default_title": "JARVIS Inspector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "toggle-inspector": {
      "suggested_key": {
        "default": "Alt+J",
        "mac": "Alt+J"
      },
      "description": "Toggle JARVIS Inspector"
    }
  }
}
